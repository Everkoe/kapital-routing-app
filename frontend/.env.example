# Storage selection. OLD is the safe compatibility default used by the
# existing Vercel deployment. V2_COMPAT is the phase-1 bridge: it uses the
# dedicated V2 credentials but reads/writes the legacy JSON row public.app_state.
# V2 (or NORMALIZED) is reserved for the phase-2 relational adapter.
KAPITAL_STORAGE_BACKEND=OLD

# OLD / legacy app_state target. Dedicated names take precedence; the legacy
# SUPABASE_* names below remain supported for existing Vercel/local envs.
KAPITAL_OLD_SUPABASE_URL=
KAPITAL_OLD_SUPABASE_KEY=
KAPITAL_OLD_READ_ONLY=false
SUPABASE_URL=
SUPABASE_KEY=
# sb_publishable_/sb_secret_ keys are sent only as `apikey`; legacy JWT keys
# retain the Authorization Bearer compatibility header in the backend.

# V2 credentials are shared by V2_COMPAT and the phase-2 NORMALIZED adapter.
# Leave disabled until the selected target and remote grants are verified. Do
# not copy OLD credentials into these variables.
KAPITAL_V2_SUPABASE_URL=
KAPITAL_V2_SUPABASE_KEY=
KAPITAL_V2_ENABLED=false
KAPITAL_V2_REMOTE_ENABLED=false
KAPITAL_V2_READ_ONLY=true
# Used only by V2/NORMALIZED. V2_COMPAT is pinned to public.app_state.
KAPITAL_V2_STATE_RESOURCE=app_state_v2

GEMINI_API_KEY=aqui_tu_api_key_de_gemini
JSON_PE_TOKEN=aqui_tu_token_de_json_pe
# Token personal de la cuenta de Supabase, solo para `scripts/aplicar_sql.py`:
# es la única vía para aplicar lo de `supabase/`, porque por PostgREST no pasa
# el DDL. La aplicación NO lo usa. Se genera en el panel, en Account → Access
# Tokens, y se ve una sola vez. Da acceso a toda la cuenta, así que no sale de
# este archivo, que está ignorado por git.
SUPABASE_ACCESS_TOKEN=aqui_tu_token_personal_de_supabase
# Cifra las contraseñas al escribirlas. Activado por defecto; ponerlo en
# false solo para volver atrás, y sabiendo que entonces se guardan en claro.
KAPITAL_PASSWORD_HASH_WRITE=true
KAPITAL_SESSION_TTL_HOURS=12
KAPITAL_AUTH_ENFORCED=true
